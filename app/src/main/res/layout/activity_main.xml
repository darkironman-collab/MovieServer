<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mobile → Laptop Relay"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Paste a direct HTTP/HTTPS MKV or media URL. The laptop plays through this phone over the same Wi-Fi." />

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="https://.../movie.mkv"
            android:inputType="textUri"
            android:minLines="2" />

        <Button
            android:id="@+id/pasteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paste Link" />

        <CheckBox
            android:id="@+id/autoPaste"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Auto Paste when app opens" />

        <CheckBox
            android:id="@+id/autoStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto Start after a new valid link" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Maximum rolling cache" />

        <Spinner
            android:id="@+id/cacheSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Prefetch threads" />

        <Spinner
            android:id="@+id/threadSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Start / Update Stream" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop Relay" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Status: stopped"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/m3uUrlText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="M3U URL: --"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/copyM3uButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copy Permanent M3U URL" />

        <TextView
            android:id="@+id/playUrlText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Play URL: --"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Tip: Reserve the phone's Wi-Fi IP in your router for a truly permanent laptop playlist URL. The .m3u endpoint itself stays /permanent.m3u." />

    </LinearLayout>
</ScrollView>
