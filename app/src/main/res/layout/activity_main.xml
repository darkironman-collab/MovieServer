<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Extreme Stream Relay"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Paste a direct HTTP/HTTPS movie URL. The phone downloads/caches it and serves the original media bytes to your laptop over the same Wi-Fi." />

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="https://.../movie.mkv"
            android:inputType="textUri"
            android:minLines="2" />

        <Button
            android:id="@+id/pasteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paste Link" />

        <CheckBox
            android:id="@+id/autoPaste"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Auto Paste when app opens" />

        <CheckBox
            android:id="@+id/autoStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto Start after a new valid link" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Maximum rolling cache" />

        <Spinner
            android:id="@+id/cacheSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Prefetch threads" />

        <Spinner
            android:id="@+id/threadSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Start / Update Stream" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop Relay" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Status: stopped"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sourceInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Source: --" />

        <TextView
            android:id="@+id/directUrlText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Direct Stream URL: --"
            android:textIsSelectable="true"
            android:textStyle="bold" />

        <Button
            android:id="@+id/copyDirectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copy Direct Stream URL" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Use this direct URL in Energy Media Player. No M3U wrapper and no transcoding: MKV/MP4/WebM data stays in its original container." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tip: Reserve the phone's Wi-Fi IP in your router if you want the laptop URL to remain unchanged after reconnecting to Wi-Fi." />

    </LinearLayout>
</ScrollView>
